# Build artifacts — never commit these; `python -m build` regenerates them.
build/
dist/
*.egg-info/
*.whl
*.tar.gz

# Environments
.venv/
venv/
env/

# Caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Website build output and the notebook copies build.sh syncs from examples/
web/_site/
web/docs/examples/*.ipynb

# Mutation testing artefacts
mutants/
.mutmut-cache
mutation.log
mutation-report.txt

# Gate output
gate_report.json

# OS / editor
.DS_Store
.idea/
.vscode/

# Notebook output — regenerated by examples/run_all.sh
examples/*.html
